# Copy to .env. Values below are local development defaults only.
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:5173
API_PORT=8000
AGENT_GATEWAY_PORT=8010

# Docker Compose local database credentials; never reuse outside local dev.
DATABASE_URL=postgresql+asyncpg://lenny:lenny_dev_only@db:5432/lenny_growth
DEMO_USER_ID=00000000-0000-4000-8000-000000000001

# Ollama runs on the host to keep access to the host GPU.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768

# `local` is the expected default. Cloud use must be explicit in the UI.
DEFAULT_PROVIDER=local
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=replace-with-supported-anthropic-model-id

# Internal Compose-only service address/token. Replace token for local runs.
AGENT_GATEWAY_URL=http://agent-gateway:8010
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-local-token

RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.25
MAX_CONTEXT_MESSAGES=12
GENERATION_TIMEOUT_SECONDS=120
