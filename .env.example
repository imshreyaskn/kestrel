# Copy to .env. Values below are local development defaults only.
APP_ENV=development
APP_LOG_LEVEL=INFO
APP_BASE_URL=http://localhost:5173
API_PORT=8000
AGENT_GATEWAY_PORT=8010

# Database configuration (PostgreSQL + pgvector)
DATABASE_URL=postgresql+asyncpg://lenny:lenny_dev_only@db:5432/lenny_growth
DEMO_USER_ID=00000000-0000-4000-8000-000000000001

# Agent Gateway Service (Pi Coding Agent SDK in Node.js)
AGENT_GATEWAY_URL=http://agent-gateway:8010
INTERNAL_SERVICE_TOKEN=replace-with-a-long-random-local-token

# Provider Selection: `local` (Ollama) or `cloud` (Gemini, Claude, OpenAI)
DEFAULT_PROVIDER=cloud
DEFAULT_CLOUD_PROVIDER=gemini

# Cloud Providers
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Local Inference (Host Ollama) - Mandatory for submitted demo
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_CHAT_MODEL=qwen2.5:1.5b
OLLAMA_EMBEDDING_MODEL=embeddinggemma
EMBEDDING_DIMENSIONS=768

# Retrieval & Context Limits
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.25
MAX_CONTEXT_MESSAGES=12
GENERATION_TIMEOUT_SECONDS=120
